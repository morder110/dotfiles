# All filetype names: /usr/share/mime/types
# Check active setting for filetype: xdg-mime query default "type/x-name"
# Test filetype name: xdg-mime query filetype "filename.ext"

# Custom fieltype rules: ~/.local/share/mime/packages
# Reload rules: update-mime-database ~/.local/share/mime

# Custom desktop files: ~/.local/share/applications
# Reload desktop files: update-desktop-database ~/.local/share/applications

[Default Applications]

# --- Web Browser ---
# Handles http links
x-scheme-handler/http=waterfox.desktop
# Handles https links
x-scheme-handler/https=waterfox.desktop
# Handles "about:" links
x-scheme-handler/about=waterfox.desktop
# Handles unknown links (fallback)
x-scheme-handler/unknown=waterfox.desktop

# --- File Manager ---
# "Open Folder" action
inode/directory=thunar.desktop

# --- Zipped/Compressed Files ---
application/zip=7zFM.desktop;

# Tarballs (compressed and uncompressed)
application/x-tar=7zFM.desktop
application/gzip=7zFM.desktop
application/x-gzip=7zFM.desktop
application/x-bzip2=7zFM.desktop
application/x-xz=7zFM.desktop
application/x-lzip=7zFM.desktop
application/x-lzma=7zFM.desktop
application/x-archive=7zFM.desktop
application/x-7z-compressed=7zFM.desktop
application/vnd.rar=7zFM.desktop

# --- Code/Text Editor ---
text/plain=code.desktop

text/html=code.desktop
text/css=code.desktop
text/x-scss=code.desktop
text/x-sass=code.desktop
application/javascript=code.desktop

text/x-csrc=code.desktop
text/x-c++src=code.desktop
text/x-csharp=code.desktop
text/x-chdr=code.desktop
text/x-cmake=code.desktop

text/x-python=code.desktop
text/x-lua=code.desktop
text/x-r=code.desktop
text/x-ruby=code.desktop
text/x-go=code.desktop
text/rust=code.desktop
text/x-java=code.desktop
application/x-php=code.desktop
application/x-shellscript=code.desktop
application/json=code.desktop
application/xml=code.desktop
text/yaml=code.desktop
application/toml=code.desktop

application/sql=code.desktop
text/x-sql=code.desktop

text/csv=code.desktop
text/tab-separated-values=code.desktop

text/markdown=obsidian.desktop
text/x-readme=code.desktop

# --- Images ---
image/jpeg=qimgv.desktop
image/jpg=qimgv.desktop
image/pjpeg=qimgv.desktop
image/png=qimgv.desktop
image/gif=qimgv.desktop
image/webp=qimgv.desktop
image/svg+xml=qimgv.desktop
image/bmp=qimgv.desktop
image/tiff=qimgv.desktop
image/x-icon=qimgv.desktop
image/vnd.microsoft.icon=qimgv.desktop

# --- Video/Audio ---
video/mp4=mpv.desktop
video/mkv=mpv.desktop
video/ogg=mpv.desktop
video/webm=mpv.desktop
# Catch-all
video/*=mpv.desktop

audio/mpeg=mpv.desktop
audio/webm=mpv.desktop
audio/x-flac+ogg=mpv.desktop
audio/vnd.wave=mpv.desktop
audio/x-wav=mpv.desktop
audio/wav=mpv.desktop

# Catch-all
audio/*=mpv.desktop

# --- PDF ---
application/pdf=waterfox.desktop

# --- Documents ---
application/vnd.oasis.opendocument.text=libreoffice-writer.desktop
application/vnd.oasis.opendocument.text-template=libreoffice-writer.desktop
application/vnd.oasis.opendocument.text-master=libreoffice-writer.desktop
application/vnd.oasis.opendocument.graphics=libreoffice-draw.desktop
application/vnd.oasis.opendocument.graphics-template=libreoffice-draw.desktop
application/vnd.oasis.opendocument.spreadsheet=libreoffice-calc.desktop
application/vnd.oasis.opendocument.spreadsheet-template=libreoffice-calc.desktop
application/vnd.oasis.opendocument.presentation=libreoffice-impress.desktop
application/vnd.oasis.opendocument.presentation-template=libreoffice-impress.desktop
application/vnd.oasis.opendocument.formula=libreoffice-math.desktop
application/vnd.oasis.opendocument.database=libreoffice-base.desktop
application/vnd.oasis.opendocument.chart=libreoffice-calc.desktop
application/vnd.oasis.opendocument.image=libreoffice-draw.desktop
application/vnd.openxmlformats-officedocument.wordprocessingml.document=libreoffice-writer.desktop
application/vnd.openxmlformats-officedocument.wordprocessingml.template=libreoffice-writer.desktop
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=libreoffice-calc.desktop
application/vnd.openxmlformats-officedocument.spreadsheetml.template=libreoffice-calc.desktop
application/vnd.openxmlformats-officedocument.presentationml.presentation=libreoffice-impress.desktop
application/vnd.openxmlformats-officedocument.presentationml.slideshow=libreoffice-impress.desktop
application/vnd.openxmlformats-officedocument.presentationml.template=libreoffice-impress.desktop
application/msword=libreoffice-writer.desktop
application/msexcel=libreoffice-calc.desktop
application/vnd.ms-excel=libreoffice-calc.desktop
application/vnd.ms-powerpoint=libreoffice-impress.desktop
application/rtf=libreoffice-writer.desktop
text/rtf=libreoffice-writer.desktop

# --- Email (mailto: links) ---
x-scheme-handler/mailto=thunderbird.desktop

# --- Torrent Magnet Links ---
x-scheme-handler/magnet=transmission-gtk.desktop

# --- Flatpak ---
application/vnd.flatpak=flatpak-installer.desktop
application/vnd.flatpak.ref=flatpak-installer.desktop
application/vnd.flatpak.repo=flatpak-installer.desktop

# --- Osu ---
application/x-osu-beatmap-archive=sh.ppy.osu.desktop
application/x-osu-skin-archive=sh.ppy.osu.desktop
application/x-osu-replay=sh.ppy.osu.desktop
application/x-osu-beatmap=sh.ppy.osu.desktop
application/x-osu-storyboard=sh.ppy.osu.desktop

# --- Muse dash ---
application/x-mdm-package=muse-dash-chart-installer.desktop

# --- Other ---
x-scheme-handler/discord=vesktop.desktop
application/octet-stream=bless.desktop
x-scheme-handler/jetbrains=jetbrainsd.desktop
x-scheme-handler/ror2mm=r2modman.desktop
application/x-zerosize=code.desktop

# ------------------------------------------------

